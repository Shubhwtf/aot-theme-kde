// Attack on Titan Plymouth theme — https://github.com/Shubhwtf/aot-theme-kde

Window.SetBackgroundTopColor(0.047, 0.039, 0.035);
Window.SetBackgroundBottomColor(0.027, 0.023, 0.020);

cx = Window.GetX() + Window.GetWidth() / 2;
cy = Window.GetY() + Window.GetHeight() / 2;

emblem.image = Image("emblem.png");
emblem.sprite = Sprite(emblem.image);
emblem.sprite.SetPosition(cx - emblem.image.GetWidth() / 2, cy - emblem.image.GetHeight() / 2 - 70, 1);

motto.image = Image("motto.png");
motto.sprite = Sprite(motto.image);
motto.sprite.SetPosition(cx - motto.image.GetWidth() / 2, cy + emblem.image.GetHeight() / 2 - 40, 1);

bar_bg.image = Image("bar-bg.png");
bar_bg.sprite = Sprite(bar_bg.image);
bar_y = cy + emblem.image.GetHeight() / 2 + 30;
bar_bg.sprite.SetPosition(cx - bar_bg.image.GetWidth() / 2, bar_y, 1);

bar_fg.original = Image("bar-fg.png");
bar_fg.sprite = Sprite();
bar_fg.sprite.SetPosition(cx - bar_bg.image.GetWidth() / 2, bar_y, 2);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_fg.original.GetWidth() * progress);
    if (w < 1) w = 1;
    bar_fg.sprite.SetImage(bar_fg.original.Scale(w, bar_fg.original.GetHeight()));
}
Plymouth.SetBootProgressFunction(progress_callback);

// slow breathing glow on the emblem
t = 0;
fun refresh_callback() {
    t++;
    emblem.sprite.SetOpacity(0.82 + 0.18 * Math.Sin(t / 30));
}
Plymouth.SetRefreshFunction(refresh_callback);

// ---------------------------------------------------------------- password prompt
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
entry.sprite = Sprite();
prompt.sprite = Sprite();
bullets = [];

fun display_password_callback(prompt_text, count) {
    entry.sprite.SetImage(entry.image);
    entry.sprite.SetPosition(cx - entry.image.GetWidth() / 2, bar_y + 40, 10);
    entry.sprite.SetOpacity(1);
    prompt.sprite.SetImage(Image.Text(prompt_text, 0.70, 0.65, 0.56));
    prompt.sprite.SetPosition(cx - entry.image.GetWidth() / 2, bar_y + 18, 10);
    prompt.sprite.SetOpacity(1);
    for (i = 0; bullets[i] || i < count; i++) {
        if (!bullets[i]) bullets[i] = Sprite(bullet.image);
        bullets[i].SetPosition(cx - entry.image.GetWidth() / 2 + 16 + i * 16, bar_y + 40 + 17, 11);
        if (i < count) bullets[i].SetOpacity(1);
        else bullets[i].SetOpacity(0);
    }
}

fun display_normal_callback() {
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// ---------------------------------------------------------------- messages
message.sprite = Sprite();
fun message_callback(text) {
    message.sprite.SetImage(Image.Text(text, 0.48, 0.43, 0.38));
    message.sprite.SetPosition(cx - message.sprite.GetImage().GetWidth() / 2, Window.GetHeight() - 60, 10);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    bar_fg.sprite.SetImage(bar_fg.original);
}
Plymouth.SetQuitFunction(quit_callback);
